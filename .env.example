# Copy to .env and fill in. Never commit .env!

# Shared secret for the transcription worker (at least 16 characters).
# Generate with: openssl rand -base64 32
WORKER_TOKEN=

# Claude API key for chapter and tag suggestions (app/server only, optional)
ANTHROPIC_API_KEY=

# Hugging Face token for speaker detection (worker only, optional).
# Accept the conditions of pyannote/speaker-diarization-community-1 on huggingface.co first.
HF_TOKEN=

# Whisper model of the worker: large-v3-turbo (faster) or large-v3 (more accurate)
WHISPER_MODEL=large-v3-turbo

# Let the worker talk to a server on the internet instead of the local app:
# WORKER_APP_URL=https://podcast.example.org

# Default UI language for visitors without a preference (en or de)
DEFAULT_LOCALE=en

# Time zone for dates in the interface
TIMEZONE=Europe/Berlin

# Maximum upload size in MB
MAX_UPLOAD_MB=2000
